{
  "name": "cursor-pets",
  "displayName": "CursorPets",
  "description": "Bring GitPets-style Codex pets into Cursor as a lightweight coding companion.",
  "version": "0.14.5",
  "publisher": "rosito",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ROSITO/cursor-pets.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:cursorPets.petView",
    "onCommand:cursorPets.showPet",
    "onCommand:cursorPets.hidePet",
    "onCommand:cursorPets.resetPet",
    "onCommand:cursorPets.selectPet",
    "onCommand:cursorPets.importPetManifest",
    "onCommand:cursorPets.importGitPetsUrl",
    "onCommand:cursorPets.announceNotification",
    "onCommand:cursorPets.testNotification",
    "onCommand:cursorPets.clearNotifications",
    "onCommand:cursorPets.startFloatingPet",
    "onCommand:cursorPets.installLoginLaunchAgent",
    "onCommand:cursorPets.uninstallLoginLaunchAgent",
    "onCommand:cursorPets.diagnoseStartup",
    "onCommand:cursorPets.announceFromClipboard",
    "onCommand:cursorPets.openChat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorPets.showPet",
        "title": "CursorPets: Show Pet"
      },
      {
        "command": "cursorPets.hidePet",
        "title": "CursorPets: Hide Pet"
      },
      {
        "command": "cursorPets.resetPet",
        "title": "CursorPets: Reset Pet"
      },
      {
        "command": "cursorPets.selectPet",
        "title": "CursorPets: Select Pet"
      },
      {
        "command": "cursorPets.importPetManifest",
        "title": "CursorPets: Import Pet Manifest"
      },
      {
        "command": "cursorPets.importGitPetsUrl",
        "title": "CursorPets: Import GitPets URL"
      },
      {
        "command": "cursorPets.announceNotification",
        "title": "CursorPets: Announce Notification"
      },
      {
        "command": "cursorPets.testNotification",
        "title": "CursorPets: Test Notification"
      },
      {
        "command": "cursorPets.clearNotifications",
        "title": "CursorPets: Clear Notifications"
      },
      {
        "command": "cursorPets.startFloatingPet",
        "title": "CursorPets: Start Floating Pet"
      },
      {
        "command": "cursorPets.installLoginLaunchAgent",
        "title": "CursorPets: Install Login Launch Agent (macOS)"
      },
      {
        "command": "cursorPets.uninstallLoginLaunchAgent",
        "title": "CursorPets: Uninstall Login Launch Agent (macOS)"
      },
      {
        "command": "cursorPets.diagnoseStartup",
        "title": "CursorPets: Diagnose Startup"
      },
      {
        "command": "cursorPets.announceFromClipboard",
        "title": "CursorPets: Announce Clipboard in Pet (e.g. AI reply)"
      },
      {
        "command": "cursorPets.openChat",
        "title": "CursorPets: Open AI Chat"
      }
    ],
    "configuration": {
      "title": "CursorPets",
      "properties": {
        "cursorPets.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable CursorPets."
        },
        "cursorPets.animationLevel": {
          "type": "string",
          "enum": [
            "still",
            "subtle",
            "playful"
          ],
          "default": "subtle",
          "description": "Controls how expressive pet animations should be."
        },
        "cursorPets.pet": {
          "type": "string",
          "default": "nukey-preview",
          "description": "The selected pet id."
        },
        "cursorPets.petCatalogSource": {
          "type": "string",
          "default": "",
          "description": "Optional local path to a GitPets-compatible pet manifest."
        },
        "cursorPets.reactToDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Let the pet react when diagnostics change."
        },
        "cursorPets.tasks.reactToProcessExit": {
          "type": "boolean",
          "default": true,
          "description": "When a task runs a real process, announce success vs failure using its exit code (via onDidEndTaskProcess). Turn off to only get the generic \"Task finished\" message on onDidEndTask."
        },
        "cursorPets.float.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the floating pet when CursorPets activates."
        },
        "cursorPets.float.backgroundOpacity": {
          "type": "number",
          "default": 0.32,
          "minimum": 0,
          "maximum": 1,
          "description": "Controls the floating pet window background opacity."
        },
        "cursorPets.float.messageOpacity": {
          "type": "number",
          "default": 0.42,
          "minimum": 0,
          "maximum": 1,
          "description": "Controls the floating pet message bubble opacity."
        },
        "cursorPets.agentTranscripts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Read Cursor Agent .jsonl transcripts under ~/.cursor/projects/<workspace>/agent-transcripts and show the latest assistant reply in the pet bubble (best-effort, Cursor-specific)."
        },
        "cursorPets.agentTranscripts.minChars": {
          "type": "number",
          "default": 24,
          "minimum": 8,
          "maximum": 500,
          "description": "Minimum visible characters required before announcing an assistant message from transcripts."
        },
        "cursorPets.agentTranscripts.maxChars": {
          "type": "number",
          "default": 3200,
          "minimum": 200,
          "maximum": 8000,
          "description": "Maximum characters of assistant text shown in the bubble."
        },
        "cursorPets.agentTranscripts.tailBytes": {
          "type": "number",
          "default": 800000,
          "minimum": 60000,
          "maximum": 2000000,
          "description": "How many trailing bytes to read from the transcript file (large logs are tail-read)."
        },
        "cursorPets.terminal.announceOutput": {
          "type": "boolean",
          "default": false,
          "description": "Announce integrated terminal shell output in the pet (command-line, not Agent chat). Prefer agent transcripts or \"Announce Clipboard in Pet\" for AI text."
        },
        "cursorPets.terminal.maxOutputChars": {
          "type": "number",
          "default": 220,
          "minimum": 80,
          "maximum": 1000,
          "description": "Max characters of terminal output to show when terminal announcements are enabled."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorPets",
          "title": "CursorPets",
          "icon": "resources/cursorpets.svg"
        }
      ]
    },
    "views": {
      "cursorPets": [
        {
          "type": "webview",
          "id": "cursorPets.petView",
          "name": "Pet"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.5.0"
  }
}
